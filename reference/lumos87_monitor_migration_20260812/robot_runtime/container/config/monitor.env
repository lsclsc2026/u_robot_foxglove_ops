# MOS Fleet Monitor runtime configuration.
# Environment variables supplied by the caller take precedence.

: ${ROS_DOMAIN_ID:=111}
: ${ROS_LOCALHOST_ONLY:=1}
: ${MOS_NAV_RVIZ:=false}
: ${MOS_BRIDGE_PORT:=8765}
: ${MOS_BRIDGE_ADDRESS:=127.0.0.1}
: ${MOS_IMAGE_JPEG_QUALITY:=58}
: ${MOS_IMAGE_MAX_FPS:=15.0}
: ${MOS_IMAGE_MAX_FRAME_AGE:=0.25}
: ${MOS_IMAGE_HEAD_WIDTH:=576}
: ${MOS_IMAGE_HEAD_HEIGHT:=324}
: ${MOS_IMAGE_ARM_WIDTH:=432}
: ${MOS_IMAGE_ARM_HEIGHT:=243}
: ${MOS_STATUS_INTERVAL:=2.0}
: ${MOS_STATUS_GRAPH_INTERVAL:=10.0}
: ${MOS_EVENT_LOG_MAX_BYTES:=1048576}

export ROS_DOMAIN_ID ROS_LOCALHOST_ONLY MOS_NAV_RVIZ
export MOS_BRIDGE_PORT MOS_BRIDGE_ADDRESS
export MOS_IMAGE_JPEG_QUALITY MOS_IMAGE_MAX_FPS MOS_IMAGE_MAX_FRAME_AGE
export MOS_IMAGE_HEAD_WIDTH MOS_IMAGE_HEAD_HEIGHT
export MOS_IMAGE_ARM_WIDTH MOS_IMAGE_ARM_HEIGHT
export MOS_STATUS_INTERVAL MOS_STATUS_GRAPH_INTERVAL
export MOS_EVENT_LOG_MAX_BYTES
