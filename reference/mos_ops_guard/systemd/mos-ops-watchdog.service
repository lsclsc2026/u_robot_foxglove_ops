[Unit]
Description=MOS read-only operations watchdog
After=network.target mos-ops-status-mux.service
Wants=mos-ops-status-mux.service

[Service]
Type=simple
Environment=ROS_DOMAIN_ID=111
Environment=ROS_LOCALHOST_ONLY=1
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source /tmp/mos_all_test_ws/install/setup.bash && exec /root/work_space/mos_ops_guard/bin/mos-watchdog --ros-args --disable-external-lib-logs'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
